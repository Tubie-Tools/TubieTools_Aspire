@page "/price-forecast"
@using System.Net.Http.Json
@using System.Collections.Generic
@inject HttpClient Http
@inject ILogger<PriceForecastComponent> Logger

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4>Price Forecasting with ONNX Models</h4>
                </div>
                <div class="card-body">
                    <!-- Single Price Prediction Section -->
                    <div class="mb-4">
                        <h5>Single Price Prediction</h5>
                        <div class="form-group">
                            <label for="currentPrice">Current Price ($):</label>
                            <input type="number" id="currentPrice" class="form-control" 
                                   @bind="currentPrice" step="0.01" min="0" 
                                   placeholder="Enter price" />
                        </div>
                        <button class="btn btn-primary" @onclick="PredictSinglePrice" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Predicting...</span>
                            }
                            else
                            {
                                <span>Get Forecast</span>
                            }
                        </button>

                        @if (singleResult != null && string.IsNullOrEmpty(singleResult.error))
                        {
                            <div class="alert alert-success mt-3">
                                <h6>Forecast Results</h6>
                                <div class="row">
                                    <div class="col-md-4">
                                        <strong>Input Price:</strong> $@singleResult.inputPrice.ToString("F2")
                                    </div>
                                    <div class="col-md-4">
                                        <strong>Forecasts:</strong>
                                        @if (singleResult.forecasts != null)
                                        {
                                            <div>
                                                @foreach (var f in singleResult.forecasts)
                                                {
                                                    <span>$@f.ToString("F2"), </span>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="col-md-4">
                                        <strong>Range:</strong>
                                        @if (singleResult.lowerBound != null && singleResult.upperBound != null)
                                        {
                                            <div>
                                                Lower: 
                                                @foreach (var f in singleResult.lowerBound)
                                                {
                                                    <span>$@f.ToString("F2") </span>
                                                }
                                                <br />
                                                Upper: 
                                                @foreach (var f in singleResult.upperBound)
                                                {
                                                    <span>$@f.ToString("F2") </span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        @if (singleResult != null && !string.IsNullOrEmpty(singleResult.error))
                        {
                            <div class="alert alert-danger mt-3">
                                <strong>Error:</strong> @singleResult.error
                            </div>
                        }
                    </div>

                    <hr />

                    <!-- Batch Prediction Section -->
                    <div class="mb-4">
                        <h5>Batch Price Prediction</h5>
                        <div class="form-group">
                            <label for="batchPrices">Prices (comma-separated):</label>
                            <textarea id="batchPrices" class="form-control" rows="3" 
                                      @bind="batchPricesText" 
                                      placeholder="e.g., 15.99, 25.50, 49.99"></textarea>
                        </div>
                        <button class="btn btn-success" @onclick="PredictBatch" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Processing...</span>
                            }
                            else
                            {
                                <span>Predict Batch</span>
                            }
                        </button>

                        @if (batchResults != null && batchResults.Count > 0)
                        {
                            <div class="alert alert-info mt-3">
                                <h6>Batch Results</h6>
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Input Price</th>
                                            <th>Forecasts</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < batchResults.Count; i++)
                                        {
                                            var prediction = batchResults[i];
                                            <tr>
                                                <td>$@batchInputPrices[i].ToString("F2")</td>
                                                <td>
                                                    @if (prediction.forecasts != null)
                                                    {
                                                        @foreach (var f in prediction.forecasts)
                                                        {
                                                            <span>$@f.ToString("F2"), </span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-danger">N/A</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (string.IsNullOrEmpty(prediction.error))
                                                    {
                                                        <span class="badge bg-success">Success</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">Error</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>

                    <!-- Health Status -->
                    <div class="mt-4">
                        <button class="btn btn-secondary btn-sm" @onclick="CheckHealth">
                            Check API Health
                        </button>
                        @if (healthStatus != null)
                        {
                            <span class="ms-2">
                                <span class="badge bg-@(healthStatus.status == "healthy" ? "success" : "danger")">
                                    @healthStatus.status
                                </span>
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Information Panel -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5>Information</h5>
                </div>
                <div class="card-body">
                    <h6>API Endpoints</h6>
                    <ul class="list-unstyled">
                        <li><code>/predict/onnx/single</code> - Single prediction</li>
                        <li><code>/predict/onnx/batch</code> - Batch predictions</li>
                        <li><code>/health</code> - Health check</li>
                    </ul>

                    <h6 class="mt-3">Features</h6>
                    <ul class="small">
                        <li>Real-time price forecasting</li>
                        <li>Confidence intervals (Lower/Upper bounds)</li>
                        <li>Batch processing support</li>
                        <li>Error handling & validation</li>
                    </ul>

                    <h6 class="mt-3">Model Details</h6>
                    <p class="small">
                        This component uses ONNX Runtime to load and execute 
                        machine learning models for price forecasting.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private class PredictionResult
    {
        public float inputPrice { get; set; }
        public float[] forecasts { get; set; }
        public float[] lowerBound { get; set; }
        public float[] upperBound { get; set; }
        public string error { get; set; }
    }

    private class HealthResult
    {
        public string status { get; set; }
        public string service { get; set; }
    }

    private float currentPrice = 0;
    private string batchPricesText = "";
    private bool isLoading = false;

    private PredictionResult singleResult;
    private List<float> batchInputPrices = new();
    private List<PredictionResult> batchResults;
    private HealthResult healthStatus;

    private async Task PredictSinglePrice()
    {
        isLoading = true;
        try
        {
            singleResult = await Http.GetFromJsonAsync<PredictionResult>(
                $"/predict/onnx/single?price={currentPrice}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error predicting single price");
            singleResult = new PredictionResult { error = $"Failed to get prediction: {ex.Message}" };
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task PredictBatch()
    {
        isLoading = true;
        try
        {
            batchInputPrices = batchPricesText
                .Split(',')
                .Select(p => float.TryParse(p.Trim(), out var f) ? f : 0)
                .Where(p => p > 0)
                .ToList();

            if (batchInputPrices.Count == 0)
            {
                singleResult = new PredictionResult { error = "No valid prices provided" };
                isLoading = false;
                return;
            }

            var response = await Http.PostAsJsonAsync("/predict/onnx/batch", batchInputPrices);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<BatchResultWrapper>();
                batchResults = result.predictions;
            }
            else
            {
                singleResult = new PredictionResult { error = "API returned an error: " + response.StatusCode };
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error predicting batch");
            singleResult = new PredictionResult { error = $"Failed to get batch prediction: {ex.Message}" };
        }
        finally
        {
            isLoading = false;
        }
    }

    private class BatchResultWrapper
    {
        public List<float> inputPrices { get; set; }
        public List<PredictionResult> predictions { get; set; }
    }

    private async Task CheckHealth()
    {
        try
        {
            healthStatus = await Http.GetFromJsonAsync<HealthResult>("/health");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error checking health");
            healthStatus = new HealthResult { status = "error", service = ex.Message };
        }
    }
}
