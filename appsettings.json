  "CareProvider": {
    "ConfigPath": "Config",
    "DaycarePath": "Config/daycare_providers.json",
    "ElderlyHomePath": "Config/elderly_home_providers.json",
    "HealthcarePath": "Config/healthcare_provider_providers.json",
    "CacheDurationMinutes": 30,
    "EnableCache": true
  },
  "Database": {
    "Timeout": 30,
    "CommandTimeout": 300,
    "MaxRetryCount": 3,
    "MaxRetryDelaySeconds": 30,
    "UseInMemory": false,
    "HealthCheckQuery": "SELECT 1"
  },
  "Api": {
    "Version": "1.0",
    "ApiKeyHeaderName": "X-API-Key",
    "TenantIdHeaderName": "X-Tenant-Id",
    "RateLimitPerMinute": 100,
    "RateLimitPerHour": 1000,
    "RateLimitPerDay": 10000,
    "EnableSwagger": true
  },
  "Security": {
    "AllowAnonymousAccess": false,
    "RequireHttps": true,
    "EnableCors": true,
    "CorsPolicy": "AllowAllOrigins",
    "CorsAllowedOrigins": ["http://localhost:3000", "http://localhost:5173", "https://your-domain.com"],
    "EnableContentSecurityPolicy": true,
    "EnableXFrameOptionsProtection": true,
    "EnableXssProtection": true
  },
  "KeyVault": {
    "Enabled": false,
    "Url": "https://your-keyvault-name.vault.azure.net/",
    "TenantId": "00000000-0000-0000-0000-000000000000",
    "ClientId": "00000000-0000-0000-0000-000000000000",
    "ClientSecret": "your-client-secret"
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"],
    "Properties": {
      "Application": "TubieTools_Aspire"
    }
  },
  "HealthChecks": {
    "Enabled": true,
    "DetailedHealthChecks": true,
    "CheckIntervalSeconds": 60,
    "TimeoutSeconds": 5
  },
  "Monitoring": {
    "ApplicationInsights": {
      "Enabled": false,
      "InstrumentationKey": "your-instrumentation-key"
    },
    "EnableMetrics": true,
    "EnableTracing": true,
    "TracingLevel": "Information"
  },
  "PaymentGateway": {
    "PayPal": {
      "Mode": "sandbox",
      "ClientId": "your-paypal-client-id",
      "ClientSecret": "your-paypal-client-secret",
      "WebhookId": "your-webhook-id"
    },
    "ApplePay": {
      "MerchantIdentifier": "your-merchant-id",
      "DisplayName": "TubieTools",
      "Initiative": "web"
    },
    "GooglePay": {
      "MerchantId": "your-merchant-id",
      "MerchantName": "TubieTools"
    },
    "AuthorizeNet": {
      "ApiLoginId": "your-api-login-id",
      "TransactionKey": "your-transaction-key",
      "Environment": "sandbox"
    }
  },
  "Features": {
    "EnableAiAgentIntegration": true,
    "EnableMultiTenancy": true,
    "EnableServiceNowIntegration": true,
    "EnableAzureIntegration": true,
    "EnableAdvancedAnalytics": false,
    "EnableMlModels": true,
    "EnableVectorSearch": false
  },
  "Cache": {
    "Enabled": true,
    "Provider": "InMemory",
    "RedisConnection": "localhost:6379",
    "DefaultExpiration": 300,
    "SlidingExpiration": 60
  },
  "Aspire": {
    "EnableDashboard": true,
    "DashboardPort": 18888,
    "GrpcPort": 4317,
    "HttpPort": 4318
  }
}
