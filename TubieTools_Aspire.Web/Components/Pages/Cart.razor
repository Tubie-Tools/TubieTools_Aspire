<!-- TubieTools_Aspire.Web/Components/Pages/Cart.razor -->
@page "/cart"
@using TubieTools_Aspire.Web.Models
@using TubieTools_Aspire.Web.Services
@inject CartService CartService
@inject NavigationManager Navigation
@rendermode InteractiveServer
@implements IAsyncDisposable

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <h1 class="mb-4">Shopping Cart</h1>

            @if (cartItems.Count == 0)
            {
                <div class="alert alert-info" role="alert">
                    <h4 class="alert-heading">Your cart is empty</h4>
                    <p>Start adding products to your cart!</p>
                    <button class="btn btn-primary" @onclick="NavigateToShop">
                        Continue Shopping
                    </button>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th>Total</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in cartItems)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="@item.ImagePath" alt="@item.ProductName" style="width: 60px; height: 60px; object-fit: cover; margin-right: 15px; border-radius: 4px;">
                                            <span>@item.ProductName</span>
                                        </div>
                                    </td>
                                    <td>$@item.Price.ToString("F2")</td>
                                    <td>
                                        <div class="input-group" style="width: 100px;">
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => UpdateQuantity(item.ProductId, item.Quantity - 1)">-</button>
                                            <input type="number" @bind="item.Quantity" min="1" class="form-control text-center" />
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => UpdateQuantity(item.ProductId, item.Quantity + 1)">+</button>
                                        </div>
                                    </td>
                                    <td><strong>$@item.TotalPrice.ToString("F2")</strong></td>
                                    <td>
                                        <button class="btn btn-sm btn-danger" @onclick="() => RemoveFromCart(item.ProductId)">
                                            Remove
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="row mt-4">
                    <div class="col-md-6">
                        <button class="btn btn-secondary" @onclick="NavigateToShop">
                            Continue Shopping
                        </button>
                        <button class="btn btn-outline-danger ms-2" @onclick="() => ClearCart()">
                            Clear Cart
                        </button>
                    </div>
                </div>
            }
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm position-sticky" style="top: 20px;">
                <div class="card-body">
                    <h5 class="card-title">Order Summary</h5>
                    <hr />

                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal:</span>
                        <span>$@subtotal.ToString("F2")</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Shipping:</span>
                        <span>$@shipping.ToString("F2")</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Tax (10%):</span>
                        <span>$@tax.ToString("F2")</span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between mb-3">
                        <h6>Total:</h6>
                        <h6 class="text-success">$@total.ToString("F2")</h6>
                    </div>

                    <button class="btn btn-success w-100 mb-2" @onclick="() => Checkout()">
                        Proceed to Checkout
                    </button>

                    <button class="btn btn-outline-primary w-100" @onclick="NavigateToShop">
                        Continue Shopping
                    </button>

                    <hr />

                    <p class="text-muted small">
                        <strong>Items in cart:</strong> @CartService.GetCartItemCount()
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<CartItem> cartItems = new();
    private decimal subtotal => CartService.GetCartTotal();
    private decimal shipping => subtotal > 50 ? 0 : 9.99m;
    private decimal tax => subtotal * 0.10m;
    private decimal total => subtotal + shipping + tax;

    protected override void OnInitialized()
    {
        cartItems = CartService.GetCartItems();
        CartService.OnCartChanged += StateHasChanged;
    }

    private void UpdateQuantity(int productId, int quantity)
    {
        CartService.UpdateQuantity(productId, quantity);
        StateHasChanged();
    }

    private void RemoveFromCart(int productId)
    {
        CartService.RemoveFromCart(productId);
        StateHasChanged();
    }

    private void ClearCart()
    {
        CartService.ClearCart();
        cartItems = CartService.GetCartItems();
        StateHasChanged();
    }
    private void NavigateToShop()
    {
        Navigation.NavigateTo("/shop");
    }

    private void Checkout()
    {
        // TODO: Implement checkout logic
        Navigation.NavigateTo("/checkout");
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        CartService.OnCartChanged -= StateHasChanged;
        await ValueTask.CompletedTask;
    }
}