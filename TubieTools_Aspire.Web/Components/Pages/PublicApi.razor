@page "/public-api"
@using TubieTools_Aspire.Web.Services
@inject PublicApiClient ApiClient
@rendermode InteractiveServer

<PageTitle>Public API - Care Providers</PageTitle>

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h1>
                    <span class="bi bi-hospital"></span>
                    Care Providers Management
                </h1>
                <button class="btn btn-primary" @onclick="() => ShowAddForm()">
                    <span class="bi bi-plus-circle"></span> Add Provider
                </button>
            </div>
            <p class="text-muted">Browse and manage all registered care providers</p>
            <hr />
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="alert alert-info">
            <span class="spinner-border spinner-border-sm me-2"></span>
            Loading care providers...
        </div>
    }
    else if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error:</strong> @ErrorMessage
            <button type="button" class="btn-close" @onclick="() => ErrorMessage = string.Empty"></button>
        </div>
    }
    else if (Providers.Count == 0)
    {
        <div class="alert alert-info">
            No care providers found. <a href="#" @onclick="() => ShowAddForm()">Add one now</a>.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var provider in Providers)
            {
                <div class="col-md-6 col-lg-4 mb-3">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">
                                @provider.Name
                                @if (provider.Rating.HasValue)
                                {
                                    <span class="badge bg-warning text-dark float-end">
                                        <span class="bi bi-star-fill"></span>
                                        @provider.Rating.Value.ToString("F1")
                                    </span>
                                }
                            </h5>
                            <p class="card-text">
                                <small class="text-muted">
                                    <strong>Type:</strong> @provider.ProviderType<br />
                                    <strong>Address:</strong> @provider.Address<br />
                                    <strong>Phone:</strong> @provider.PhoneNumber<br />
                                    <strong>Email:</strong> @provider.Email
                                </small>
                            </p>
                        </div>
                        <div class="card-footer bg-light">
                            <small class="text-muted">ID: @provider.Id</small>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (ShowForm)
    {
        <div class="modal" style="display: block; background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Add New Care Provider</h5>
                        <button type="button" class="btn-close" @onclick="() => ShowForm = false"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <input type="text" class="form-control" @bind="NewProvider.Name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Type</label>
                            <input type="text" class="form-control" @bind="NewProvider.ProviderType" placeholder="e.g., Hospital, Clinic, Care Home" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Address</label>
                            <input type="text" class="form-control" @bind="NewProvider.Address" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Phone</label>
                            <input type="text" class="form-control" @bind="NewProvider.PhoneNumber" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" @bind="NewProvider.Email" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="() => ShowForm = false">
                            Cancel
                        </button>
                        <button type="button" class="btn btn-primary" @onclick="SubmitProvider">
                            Save Provider
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<CareCareProvider> Providers = new();
    private CareCareProvider NewProvider = new();
    private bool IsLoading;
    private bool ShowForm;
    private string ErrorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadProviders();
    }

    private async Task LoadProviders()
    {
        IsLoading = true;
        ErrorMessage = string.Empty;
        try
        {
            Providers = await ApiClient.GetCareProvidersAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to load providers: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ShowAddForm()
    {
        NewProvider = new();
        ShowForm = true;
    }

    private async Task SubmitProvider()
    {
        if (string.IsNullOrWhiteSpace(NewProvider.Name))
        {
            ErrorMessage = "Provider name is required";
            return;
        }

        try
        {
            var result = await ApiClient.CreateCareProviderAsync(NewProvider);
            if (result?.Success == true)
            {
                ShowForm = false;
                await LoadProviders();
                ErrorMessage = string.Empty;
            }
            else
            {
                ErrorMessage = result?.Message ?? "Failed to create provider";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error creating provider: {ex.Message}";
        }
    }
}
