      "EnableWebhooks": true,
      "EnableCustomAnalytics": true,
      "EnableMultiAgent": true,
      "EnableDisasterRecovery": true,
      "SsoEnabled": true,
      "IsActive": true,
      "Region": "US",
      "CreatedDate": "2024-01-01T00:00:00Z"
    }
