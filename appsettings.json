{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information",
      "Microsoft.Extensions.Http": "Debug"
    },
    "EnableConsole": true,
    "EnableFile": false,
    "LogFilePath": "logs/app-.txt"
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=TubieTools;Trusted_Connection=true;",
    "FoundryConnection": "Server=localhost;Database=TubieTools_Foundry;Trusted_Connection=true;",
    "FoundryConnection_CA": "Server=localhost;Database=TubieTools_CA;Trusted_Connection=true;",
    "FoundryConnection_TX": "Server=localhost;Database=TubieTools_TX;Trusted_Connection=true;",
    "FoundryConnection_NY": "Server=localhost;Database=TubieTools_NY;Trusted_Connection=true;",
    "AzureSqlConnection": "Server=tcp:your-server.database.windows.net,1433;Initial Catalog=YourDatabase;Persist Security Info=False;User ID=sqladmin;Password=YourPassword;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "Authentication": {
    "Entra": {
      "TenantId": "common",
      "ClientId": "00000000-0000-0000-0000-000000000000",
      "Instance": "https://login.microsoftonline.com/",
      "Authority": "https://login.microsoftonline.com/common",
      "CallbackPath": "/signin-oidc",
      "SignedOutCallbackPath": "/signout-callback-oidc",
      "Audience": "api://your-app-id"
    },
    "Okta": {
      "Domain": "https://your-domain.okta.com",
      "ClientId": "your-client-id",
      "ClientSecret": "your-client-secret",
      "AuthorizationServerId": "default",
      "RedirectUri": "http://localhost:5000/authorization-code/callback"
    }
  },
  "ChatGPT": {
    "ApiKey": "sk-your-openai-api-key",
    "Model": "gpt-4-turbo",
    "Temperature": 0.7,
    "MaxTokens": 2000,
    "OrganizationId": "org-your-org-id",
    "Endpoint": "https://api.openai.com/v1"
  },
  "Embedding": {
    "EmbeddingProvider": "OpenAI",
    "EmbeddingModel": "text-embedding-3-small",
    "EmbeddingDimension": 1536,
    "VectorStoreBackend": "Pinecone",
    "VectorStoreConnection": "your-vector-store-connection-string",
    "VectorStoreApiKey": "your-vector-store-api-key",
    "SimilarityMetric": "cosine",
    "ReembeddingFrequency": "Weekly"
  },
  "ServiceNow": {
    "Instance": "dev12345",
    "InstanceUrl": "https://dev12345.service-now.com",
    "Token": "your-oauth-bearer-token",
    "OAuthClientId": "your-oauth-client-id",
    "OAuthClientSecret": "your-oauth-client-secret",
    "TimeoutSeconds": 30,
    "MaxRetries": 3,
    "RetryDelaySeconds": 1
  },
  "Azure": {
    "SubscriptionId": "00000000-0000-0000-0000-000000000000",
    "ResourceGroup": "your-resource-group",
    "Region": "eastus",
    "TenantId": "00000000-0000-0000-0000-000000000000",
    "ClientId": "00000000-0000-0000-0000-000000000000",
    "ClientSecret": "your-client-secret"
  },
  "AzureDevOps": {
    "OrganizationUrl": "https://dev.azure.com/your-organization",
    "PatToken": "your-personal-access-token",
    "Project": "your-project-name"
  },
  "AzureAutomation": {
    "SubscriptionId": "00000000-0000-0000-0000-000000000000",
    "ResourceGroup": "your-resource-group",
    "AccountName": "your-automation-account",
    "RunbookName": "your-runbook-name"
  },
  "Kubernetes": {
    "ClusterName": "your-aks-cluster",
    "ResourceGroup": "your-resource-group",
    "Namespace": "default",
    "Context": "your-context-name",
    "ConfigPath": "~/.kube/config"
  },
  "Terraform": {
    "StorageAccount": "your-storage-account",
    "StorageContainer": "terraform-state",
    "ResourceGroup": "your-terraform-rg",
    "StateFilePath": "prod/terraform.tfstate",
    "BackendKey": "terraform.tfstate"
  },
  "Tenant": {
    "TenantId": "common",
    "ServiceName": "TubieTools Service",
    "DefaultSubscriptionTier": "Free",
    "DefaultRegion": "US"
  },
  "Tenants": [
