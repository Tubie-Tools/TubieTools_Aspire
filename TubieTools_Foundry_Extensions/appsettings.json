"FoundryExtension": {
  "RepositoryPath": "./models",
  "MaxConcurrentModels": 5,
  "ModelTimeoutSeconds": 300,
  "EnableCaching": true,
  "CacheDurationMinutes": 60,
  "Providers": {
    "Azure": {
      "ApiKey": "${AZURE_OPENAI_API_KEY}",
      "BaseUrl": "${AZURE_OPENAI_ENDPOINT}",
      "Options": {}
    },
    "OpenAI": {
      "ApiKey": "${OPENAI_API_KEY}",
      "BaseUrl": "https://api.openai.com/v1",
      "Options": {}
    }
  }
}