@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="wrapper">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="">
                <span class="oi oi-map"></span> TubieTools Map
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                            <span class="oi oi-home"></span> Home
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="my-routes">
                            <span class="oi oi-action-redo"></span> My Routes
                        </NavLink>
                    </li>
                    <AuthorizeView Roles="Admin">
                        <li class="nav-item">
                            <NavLink class="nav-link" href="admin/routes">
                                <span class="oi oi-cog"></span> Admin
                            </NavLink>
                        </li>
                    </AuthorizeView>
                    <li class="nav-item dropdown">
                        <AuthorizeView>
                            <Authorized>
                                <a class="nav-link dropdown-toggle" href="#" id="userMenu" role="button" data-bs-toggle="dropdown">
                                    <span class="oi oi-person"></span> @context.User.FindFirst(ClaimTypes.Name)?.Value
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenu">
                                    <li><NavLink class="dropdown-item" href="profile">Profile</NavLink></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="MicrosoftIdentity/Account/SignOut">Logout</a></li>
                                </ul>
                            </Authorized>
                            <NotAuthorized>
                                <a class="nav-link" href="MicrosoftIdentity/Account/SignIn">Login</a>
                            </NotAuthorized>
                        </AuthorizeView>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container-fluid py-4">
        <AuthorizeView>
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
            <Authorized>
                @Body
            </Authorized>
        </AuthorizeView>
    </main>

    <footer class="footer mt-auto py-3 bg-light border-top">
        <div class="container text-center">
            <span class="text-muted">© 2024 TubieTools. All rights reserved.</span>
        </div>
    </footer>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }
}