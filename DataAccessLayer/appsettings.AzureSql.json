{
  "SqlAzure": {
    "Server": "your-sql-server.database.windows.net",
    "Database": "TubieDb",
    "UserId": "sqladmin",
    "Password": "${SQL_PASSWORD}",
    "ConnectTimeout": 30,
    "CommandTimeout": 300,
    "EnableRetryOnFailure": true,
    "MaxRetryCount": 3,
    "MaxRetryDelay": 5,
    "Encrypt": true,
    "TrustServerCertificate": false
  },
  "SqlAzure:Identity": {
    "Server": "your-sql-server.database.windows.net",
    "Database": "TubieIdentityDb",
    "UserId": "sqladmin",
    "Password": "${SQL_PASSWORD}",
    "ConnectTimeout": 30,
    "CommandTimeout": 300,
    "EnableRetryOnFailure": true,
    "MaxRetryCount": 3
  },
  "SqlAzure:Tubie": {
    "Server": "your-sql-server.database.windows.net",
    "Database": "TubieDb",
    "UserId": "sqladmin",
    "Password": "${SQL_PASSWORD}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Debug"
    }
  }
}
